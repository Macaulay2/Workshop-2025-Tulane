TEST ///
    I = cayleyMengerDeterminants(5,2);
    R2 = QQ[x1,y1,x2,y2,x3,y3,x4,y4,x5,y5];
    for p in first entries gens I do assert(sub(p, {
        d_(1,2) => (x1-x2)^2+(y1-y2)^2,
        d_(1,3) => (x1-x3)^2+(y1-y3)^2,
        d_(1,4) => (x1-x4)^2+(y1-y4)^2,
        d_(1,5) => (x1-x5)^2+(y1-y5)^2,
        d_(2,3) => (x2-x3)^2+(y2-y3)^2,
        d_(2,4) => (x2-x4)^2+(y2-y4)^2,
        d_(2,5) => (x2-x5)^2+(y2-y5)^2,
        d_(3,4) => (x3-x4)^2+(y3-y4)^2,
        d_(3,5) => (x3-x5)^2+(y3-y5)^2,
        d_(4,5) => (x4-x5)^2+(y4-y5)^2}
        ) == 0)
///
TEST ///
    I = cayleyMengerDeterminants(5,2);
    R3 = QQ[x1,y1,z1,x2,y2,z2,x3,y3,z3,x4,y4,z4,x5,y5,z5];
    for p in first entries gens I do assert(sub(p, {
        d_(1,2) => (x1-x2)^2+(y1-y2)^2+(z1-z2)^2,
        d_(1,3) => (x1-x3)^2+(y1-y3)^2+(z1-z3)^2,
        d_(1,4) => (x1-x4)^2+(y1-y4)^2+(z1-z4)^2,
        d_(1,5) => (x1-x5)^2+(y1-y5)^2+(z1-z5)^2,
        d_(2,3) => (x2-x3)^2+(y2-y3)^2+(z2-z3)^2,
        d_(2,4) => (x2-x4)^2+(y2-y4)^2+(z2-z4)^2,
        d_(2,5) => (x2-x5)^2+(y2-y5)^2+(z2-z5)^2,
        d_(3,4) => (x3-x4)^2+(y3-y4)^2+(z3-z4)^2,
        d_(3,5) => (x3-x5)^2+(y3-y5)^2+(z3-z5)^2,
        d_(4,5) => (x4-x5)^2+(y4-y5)^2+(z4-z5)^2}
        ) != 0)
///